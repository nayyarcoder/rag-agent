# Production Environment Variables
# Copy this file to .env and configure your values

# LLM Provider Configuration
# Supported providers: groq, openai, anthropic, ollama
LLM_PROVIDER=groq

# API Keys (Required for cloud providers)
# Groq API Key (for Groq provider)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (for OpenAI provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Anthropic provider) 
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (for local inference)
# OLLAMA_API_BASE=http://localhost:11434

# Generic LLM API Key (for other providers)
# LLM_API_KEY=your_api_key_here

# Custom API Base URL (for self-hosted or custom endpoints)
# LLM_API_BASE=https://your-custom-endpoint.com

# Document Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Vector Store Configuration
VECTOR_DB_PATH=db
COLLECTION_NAME=documents

# LLM Configuration
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Application Configuration
ENVIRONMENT=production
DEBUG=false

# Security Configuration
SCAN_UPLOADS=true
MAX_CONCURRENT_UPLOADS=10

# Performance Configuration
MAX_WORKERS=4